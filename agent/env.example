# Скопируй этот файл в .env и заполни.

# Токен, которым сервер подтверждает себя агенту (не короче 24 символов).
# Сгенерировать:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Такое же значение нужно вписать в AGENT_TOKEN на сервере.
AGENT_TOKEN=

# На каком адресе слушать.
#   127.0.0.1  — только этот компьютер (для проверки)
#   10.8.0.2   — адрес компьютера внутри WireGuard/Tailscale (боевая схема)
# Никогда не ставь 0.0.0.0, если компьютер доступен из интернета.
AGENT_HOST=127.0.0.1
AGENT_PORT=8765

# Разрешённые папки: имя=путь;имя2=путь2
# Всё, что вне этих папок, недоступно. Игнорируется, если ALLOW_ALL_FILES=1.
ALLOWED_DIRS=docs=C:\Users\Me\Documents;photos=D:\Photos

# 1 — виден весь диск целиком (все файлы компьютера), а не только папки выше.
# ВНИМАНИЕ: тогда через сайт доступны ВСЕ файлы, включая системные. Включай,
# только если сайт надёжно защищён (пароль + токен + доступ лишь из своей VPN).
ALLOW_ALL_FILES=0

# 1 — разрешить управление мышью и клавиатурой с сайта. 0 — запретить.
INPUT_ENABLED=1

# 1 — разрешить камеру с сайта. 0 (по умолчанию) — запретить: камера личнее
# экрана и файлов, включай осознанно.
CAMERA_ENABLED=0

# mss — настоящий экран; test — картинка-заглушка (проверка без экрана)
SCREEN_BACKEND=mss

# Адрес сайта: агент сам сообщает ему свой адрес в VPN (необязательно)
SERVER_URL=

# Необязательно: как этот компьютер назовётся на сайте (в переключателе между
# несколькими компьютерами). Если не задано — используется имя компьютера в Windows.
# Можно позже переименовать прямо на сайте (вкладка «Установка» -> «Мои компьютеры»).
DEVICE_NAME=

# Максимальный размер загружаемого файла, МБ
MAX_UPLOAD_MB=2048
