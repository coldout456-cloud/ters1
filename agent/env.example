# Скопируй этот файл в .env и заполни.

# Токен, которым сервер подтверждает себя агенту (не короче 24 символов).
# Сгенерировать:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Такое же значение нужно вписать в AGENT_TOKEN на сервере.
AGENT_TOKEN=

# На каком адресе слушать.
#   127.0.0.1  — только этот компьютер (для проверки)
#   10.8.0.2   — адрес компьютера внутри WireGuard/Tailscale (боевая схема)
# Никогда не ставь 0.0.0.0, если компьютер доступен из интернета.
AGENT_HOST=127.0.0.1
AGENT_PORT=8765

# Разрешённые папки: имя=путь;имя2=путь2
# Всё, что вне этих папок, недоступно.
ALLOWED_DIRS=docs=C:\Users\Me\Documents;photos=D:\Photos

# mss — настоящий экран; test — картинка-заглушка (проверка без экрана)
SCREEN_BACKEND=mss

# Максимальный размер загружаемого файла, МБ
MAX_UPLOAD_MB=2048
