# Скопируй этот файл в .env и заполни.

# Общий токен для всех компьютеров (должен совпадать с AGENT_TOKEN в agent/.env
# на каждом из них). Сам адрес каждого агента сервер узнаёт автоматически —
# при регистрации агент сообщает и свой адрес, и свой device_id, так что сайт
# может работать сразу с несколькими компьютерами (список — вкладка «Установка»).
AGENT_TOKEN=

# Логин и хэш пароля. Хэш получить так:  python security.py
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# Ключ подписи сессий (не короче 32 символов). Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Сколько часов живёт вход
SESSION_HOURS=12

# 1 — куки только по https (боевой режим). 0 — только для проверки по http://localhost
COOKIE_SECURE=1

# 1 — если перед сервером стоит Caddy/nginx (тогда берём реальный IP из X-Forwarded-For)
TRUST_PROXY=1

# Адрес сайта. Нужен, чтобы сайт выдавал установщик для дачи (вкладка «Установка»).
PUBLIC_URL=https://dacha.example.com

# Необязательно: ключ Tailscale (Settings -> Keys -> Generate auth key, галочка Reusable).
# Если задан, установщик для дачи входит в Tailscale сам. Проще задать командой: dacha-set-tskey
TAILSCALE_AUTHKEY=

# Сервер слушает только локально, наружу его выставляет Caddy
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Необязательно: вход по коду из приложения-аутентификатора (2FA), вдобавок к паролю.
# Проще настроить командой на сервере: dacha-set-2fa (она же сама впишет эти строки)
TOTP_ENABLED=0
TOTP_SECRET=
